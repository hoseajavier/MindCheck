generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  ADMIN
}

model User {
  id            String       @id @default(cuid())
  name          String?
  email         String       @unique
  emailVerified DateTime?
  image         String?
  displayName   String?
  bio           String?

  role          UserRole     @default(USER)

  lastQuizDate  DateTime?
  streak        Int          @default(0)

  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @default(now()) @updatedAt

  accounts      Account[]
  sessions      Session[]

  dailyMoods    DailyMood[]
  testResults   TestResult[]
}

enum QuestionCategory {
  SNORING_RATE
  RESPIRATION_RATE
  BODY_TEMPERATURE
  LIMB_MOVEMENT
  BLOOD_OXYGEN
  EYE_MOVEMENT
  SLEEPING_HOURS
  HEART_RATE
}

model Question {
  id          String           @id @default(cuid())
  question    String
  orderNumber Int              @unique
  category    QuestionCategory
  
  isActive    Boolean          @default(true)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model DatasetRecord {
  id                String @id @default(cuid())

  snoringRate       Float
  respirationRate   Float
  bodyTemperature   Float
  limbMovement      Float
  bloodOxygen       Float
  eyeMovement       Float
  sleepingHours     Float
  heartRate         Float

  stressLevel       Int

  importedAt        DateTime @default(now())
}

model ModelMetadata {
  id           String   @id @default(cuid())
  modelName    String
  updatedAt    DateTime @default(now())
}

model DailyMood {
  id        String   @id @default(cuid())
  userId    String
  mood      String  
  date      String  
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date]) 
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  access_token      String?
  expires_at        Int?
  id_token          String?
  scope             String?
  session_state     String?
  token_type        String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model TestResult {
  id        String   @id @default(cuid())
  userId    String
  score     Int
  level     String
  createdAt DateTime @default(now())
  answers   Json
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}
