generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String       @id @default(cuid())
  name          String?
  email         String       @unique
  emailVerified DateTime?
  image         String?
  bio           String?
  displayName   String?
  lastQuizDate  DateTime?
  streak        Int          @default(0)
  accounts      Account[]
  sessions      Session[]
  dailyMoods    DailyMood[]
  testResults   TestResult[]
}

model DailyMood {
  id        String   @id @default(cuid())
  userId    String
  mood      String  
  date      String  
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date]) 
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  access_token      String?
  expires_at        Int?
  id_token          String?
  scope             String?
  session_state     String?
  token_type        String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model TestResult {
  id        String   @id @default(cuid())
  userId    String
  score     Int
  level     String
  createdAt DateTime @default(now())
  answers   Int[]
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}
